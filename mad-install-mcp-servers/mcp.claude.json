{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${CLAUDE_GITHUB_TOKEN}"
      }
    },
    "notion": {
      "url": "https://mcp.notion.com/mcp"
    },
    "gitlab": {
      "command": "npx",
      "args": ["-y", "@ttpears/gitlab-mcp-server@latest"],
      "env": {
        "GITLAB_URL": "https://gitlab.com",
        "GITLAB_TOKEN": "${CLAUDE_GITLAB_TOKEN}"
      }
    },
    "mcp-atlassian": {
      "command": "uvx",
      "args": ["mcp-atlassian"],
      "env": {
        "JIRA_URL": "${CLAUDE_JIRA_URL}",
        "JIRA_USERNAME": "${CLAUDE_JIRA_USERNAME}",
        "JIRA_API_TOKEN": "${CLAUDE_JIRA_API_TOKEN}",
        "CONFLUENCE_URL": "${CLAUDE_CONFLUENCE_URL}",
        "CONFLUENCE_USERNAME": "${CLAUDE_CONFLUENCE_USERNAME}",
        "CONFLUENCE_API_TOKEN": "${CLAUDE_CONFLUENCE_API_TOKEN}"
      }
    }
  }
}
